{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aacr.dev/schemas/evidence.schema.json",
  "title": "AACR PostgreSQL deactivate_user evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution_id", "provider", "operation", "status", "affected_rows", "state_delta"],
  "properties": {
    "execution_id": { "type": "string", "minLength": 1 },
    "provider": { "const": "postgresql" },
    "operation": { "const": "deactivate_user" },
    "status": { "const": "COMMITTED" },
    "affected_rows": { "const": 1 },
    "state_delta": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "active"],
        "properties": {
          "id": { "type": "integer" },
          "version": { "type": "integer" },
          "active": { "type": "boolean", "const": false }
        }
      }
    }
  }
}
